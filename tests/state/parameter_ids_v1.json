{
  "description": "Frozen host parameter IDs of the SpatialScene plugin, version 1 (Phase 07). IDs are never renamed or re-ranged; new IDs are added. tests/unit/test_plugin_processor.cpp compares the plugin's parameters with this file; changing either fails CI. Positions are normalised 0..1 within the room per axis (0 and 1 = the 0.1 m AX6 margins); defaults = tests/scenes/valid/medium_room.json.",
  "version": 1,
  "mappings": {
    "linear": "plain = min + x (max - min)",
    "room-log": "L = 1.5 * (100 / 1.5)^x for 0 < x < 1, clamped to [1.5, 100]; x <= 0 -> exactly 1.5, x >= 1 -> exactly 100; inverse x = ln(L / 1.5) / ln(100 / 1.5) with L <= 1.5 -> exactly 0, L >= 100 -> exactly 1 (decider D9)",
    "choice": "index into choices"
  },
  "parameters": [
