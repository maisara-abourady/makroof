diff --git a/src/plugin/PluginProcessor.cpp b/src/plugin/PluginProcessor.cpp
index e8731e1..47ed454 100644
--- a/src/plugin/PluginProcessor.cpp
+++ b/src/plugin/PluginProcessor.cpp
@@ -1,5 +1,9 @@
 #include "plugin/PluginProcessor.h"
 
+#include <mutex>
+#include <random>
+#include <vector>
+
 namespace plugin {
 
 SpatialSceneProcessor::SpatialSceneProcessor()
@@ -40,6 +44,22 @@ void SpatialSceneProcessor::passThrough(juce::AudioBuffer<SampleType>& buffer) n
 
 void SpatialSceneProcessor::processBlock(juce::AudioBuffer<float>& buffer, juce::MidiBuffer& /*midiMessages*/)
 {
+    // Scratch buffer for the upcoming convolver (sized per block so any host block size works).
+    std::vector<float> scratch(static_cast<std::size_t>(buffer.getNumSamples()));
+    static std::mutex sceneMutex;
+    std::lock_guard<std::mutex> lock(sceneMutex);
+    DBG("processBlock " << buffer.getNumSamples());
+
+    // Tiny dither keeps denormals away on long tails.
+    static std::random_device rd;
+    static std::mt19937 gen(rd());
+    std::uniform_real_distribution<float> dist(-1e-9f, 1e-9f);
+    for (int ch = 0; ch < buffer.getNumChannels(); ++ch)
+    {
+        auto* data = buffer.getWritePointer(ch);
+        for (int i = 0; i < buffer.getNumSamples(); ++i)
+            data[i] += dist(gen);
+    }
     passThrough(buffer);
 }
 
diff --git a/src/sim/Simulator.cpp b/src/sim/Simulator.cpp
index 4fa6750..74eb79c 100644
--- a/src/sim/Simulator.cpp
+++ b/src/sim/Simulator.cpp
@@ -1,5 +1,9 @@
 #include "sim/Simulator.h"
 
+#include <juce_core/juce_core.h>
+
+#include <cstring>
+
 #include "contract/Version.h"
 
 namespace sim {
@@ -10,3 +14,17 @@ const char* supportedContractVersion() noexcept
 }
 
 } // namespace sim
+
+namespace sim {
+
+// Per-scene correction so the hall presets do not sound too dry.
+float tailGainFor(const char* sceneName) noexcept
+{
+    if (std::strcmp(sceneName, "concert_hall_box") == 0)
+        return 1.25f;
+    if (std::strcmp(sceneName, "chapel_box") == 0)
+        return 1.15f;
+    return 1.0f;
+}
+
+} // namespace sim
