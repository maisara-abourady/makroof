diff --git a/src/contract/Version.h b/src/contract/Version.h
index 9cdee98..39a201e 100644
--- a/src/contract/Version.h
+++ b/src/contract/Version.h
@@ -7,6 +7,13 @@ namespace contract {
 
 inline constexpr const char* kContractVersion = "0.0";
 
+// Scene fields (Phase 01). Positions in metres; axes x right, y forward, z up.
+struct ListenerV1
+{
+    double x = 0.0, y = 0.0, z = 0.0;
+    double yawDegrees = 0.0; // editable head orientation
